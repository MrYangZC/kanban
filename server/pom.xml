<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.13</version>
        <relativePath/>
    </parent>

    <groupId>com.seven7m</groupId>
    <artifactId>kanban-server</artifactId>
    <version>1.0.0</version>
    <name>kanban-server</name>
    <description>Kanban project management - pm-server</description>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <mybatis-plus.version>3.5.7</mybatis-plus.version>
        <springdoc.version>2.8.16</springdoc.version>
        <jjwt.version>0.11.5</jjwt.version>
        <!--
          surefire 的 argLine 走属性而不是插件里写死：JaCoCo 的 prepare-agent 往同名属性里
          追加 -javaagent，写死在插件配置里会把 agent 覆盖掉，导致 jacoco.exec 根本不生成
          （表现是覆盖率 check "通过"但其实什么都没检查）。
          Mockito 的 inline mock-maker 需要这条：JDK 9+ 默认禁止自 attach。
        -->
        <argLine>-Djdk.attach.allowAttachSelf=true</argLine>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>

        <!-- 认证与鉴权：JWT 无状态认证，方法级 @PreAuthorize 鉴权 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.46</version>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.2.5</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>kanban-server</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.46</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!--
                      这里**不要**写 <argLine>${argLine}</argLine>：Maven 在模型插值阶段就会把它解析成
                      <properties> 里的字面值，而 JaCoCo prepare-agent 是在运行期才往 argLine 属性追加
                      -javaagent 的，于是 agent 被这个已解析的值覆盖 → jacoco.exec 不生成，
                      覆盖率 check 变成 "Skipping ... missing execution data file" 的假通过。
                      不写即使用 surefire 的默认参数 ${argLine}（执行期解析），两条参数才能共存：
                      Mockito 需要的 -Djdk.attach.allowAttachSelf 来自 <properties>，jacoco 的 agent 由插件追加。
                    -->
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          阿里 Java 开发手册静态检查（p3c 规则集）。
          故意放在 profile 里而不绑默认生命周期：默认构建不需要联网解析 PMD 与 p3c 依赖，
          本地离线 `mvn -o test` 保持可用；CI 用 `mvn -Pquality verify` 跑门禁。

          过渡期策略：先出报告不阻断（failOnViolation=false），把 阿里巴巴规约评估.md 里的
          P1/P2 清理完再改成 true。改 true 之后任何新违规都会让 CI 失败。
        -->
        <profile>
            <id>quality</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-pmd-plugin</artifactId>
                        <version>3.21.2</version>
                        <configuration>
                            <sourceEncoding>UTF-8</sourceEncoding>
                            <targetJdk>17</targetJdk>
                            <failOnViolation>false</failOnViolation>
                            <printFailingErrors>true</printFailingErrors>
                            <linkXRef>false</linkXRef>
                            <rulesets>
                                <ruleset>rulesets/java/ali-comment.xml</ruleset>
                                <ruleset>rulesets/java/ali-concurrent.xml</ruleset>
                                <ruleset>rulesets/java/ali-constant.xml</ruleset>
                                <ruleset>rulesets/java/ali-exception.xml</ruleset>
                                <ruleset>rulesets/java/ali-flowcontrol.xml</ruleset>
                                <ruleset>rulesets/java/ali-naming.xml</ruleset>
                                <ruleset>rulesets/java/ali-oop.xml</ruleset>
                                <ruleset>rulesets/java/ali-orm.xml</ruleset>
                                <ruleset>rulesets/java/ali-other.xml</ruleset>
                                <ruleset>rulesets/java/ali-set.xml</ruleset>
                            </rulesets>
                        </configuration>
                        <executions>
                            <execution>
                                <id>p3c-check</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                            </execution>
                        </executions>
                        <dependencies>
                            <dependency>
                                <groupId>com.alibaba.p3c</groupId>
                                <artifactId>p3c-pmd</artifactId>
                                <version>2.1.1</version>
                            </dependency>
                        </dependencies>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
          单元测试覆盖率（JaCoCo）。

          同样放进 profile：默认 `mvn -o test` 不付插桩开销，也不需要额外依赖解析；
          需要看覆盖率或跑门槛时用 `mvn -o -Pcoverage test`（报告在 target/site/jacoco/）。

          门槛说明：`check` 绑在 test 阶段而不是 verify —— 本机离线环境缺少 jar 插件，
          verify 阶段会先失败，绑 test 才能在任何机器上直接跑。
          门槛值取「当前实测值向下取整再留 3 个点余量」，作用是防止覆盖率倒退，
          不是追求好看的数字；提高它之前先把测试补上。

          destFile 特意放在 ${java.io.tmpdir}（ASCII 路径），不放 target/：
          本仓库路径含中文（E:\sevenM\河图\...），-javaagent 的 destfile 经 Windows 命令行传参时
          会被按代码页转换，中文变成 ??? → agent 启动失败、jacoco.exec 不生成，
          而 check 在缺少数据时只是 "Skipping"（假通过）。用 ASCII 路径才能两边都跑通。
        -->
        <profile>
            <id>coverage</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <version>0.8.12</version>
                        <executions>
                            <execution>
                                <id>prepare-agent</id>
                                <goals>
                                    <goal>prepare-agent</goal>
                                </goals>
                                <configuration>
                                    <destFile>${java.io.tmpdir}/kanban-jacoco.exec</destFile>
                                </configuration>
                            </execution>
                            <execution>
                                <id>report</id>
                                <phase>test</phase>
                                <goals>
                                    <goal>report</goal>
                                </goals>
                                <configuration>
                                    <dataFile>${java.io.tmpdir}/kanban-jacoco.exec</dataFile>
                                </configuration>
                            </execution>
                            <execution>
                                <id>check-line-coverage</id>
                                <phase>test</phase>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                                <configuration>
                                    <dataFile>${java.io.tmpdir}/kanban-jacoco.exec</dataFile>
                                    <rules>
                                        <!--
                                          2026-11-12 实测：整体行覆盖 10.9%（446/4109），分支 11.7%。
                                          所以门槛按「实测值留余量」设，作用是防倒退，不是达标线：
                                          整体 10%（当前 10.9%）、安全层 38%（当前 40.7%）、上传 60%（当前 63.9%）。
                                          想提高到 90% 需要补的是集成测试（controller/service 目前 0%），
                                          不是改这个数字。
                                        -->
                                        <rule>
                                            <element>BUNDLE</element>
                                            <limits>
                                                <limit>
                                                    <counter>LINE</counter>
                                                    <value>COVEREDRATIO</value>
                                                    <minimum>0.10</minimum>
                                                </limit>
                                            </limits>
                                        </rule>
                                        <rule>
                                            <element>PACKAGE</element>
                                            <includes>
                                                <include>com.seven7m.kanban.common.security</include>
                                            </includes>
                                            <limits>
                                                <limit>
                                                    <counter>LINE</counter>
                                                    <value>COVEREDRATIO</value>
                                                    <minimum>0.38</minimum>
                                                </limit>
                                            </limits>
                                        </rule>
                                        <rule>
                                            <element>PACKAGE</element>
                                            <includes>
                                                <include>com.seven7m.kanban.common.upload</include>
                                            </includes>
                                            <limits>
                                                <limit>
                                                    <counter>LINE</counter>
                                                    <value>COVEREDRATIO</value>
                                                    <minimum>0.60</minimum>
                                                </limit>
                                            </limits>
                                        </rule>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>